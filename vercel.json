{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>.*)\\.vercel\\.app"
        }
      ],
      "destination": "https://vinotecalarecta.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.vinotecalarecta\\.com"
        }
      ],
      "destination": "https://vinotecalarecta.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/productos",
      "destination": "/productos.html"
    },
    {
      "source": "/mayorista",
      "destination": "/mayorista.html"
    }
  ]
}
